# ==============================================================================
# Leaders Document Intelligence (LDI) - Environment Configuration
# ==============================================================================

APP_NAME="Leaders Document Intelligence"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api

# Security & JWT (CHANGE IN PRODUCTION)
SECRET_KEY=replace-with-a-64-char-cryptographically-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SIGNED_URL_SECRET=replace-with-a-separate-64-char-signed-url-secret
SIGNED_URL_TTL_SECONDS=300
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
ENCRYPTION_KEY=replace-with-32-byte-base64-key-for-at-rest-metadata

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL in Docker/Production; SQLite fallback supported for standalone local dev)
DATABASE_URL=postgresql+psycopg://ldi_user:ldi_password@localhost:5432/ldi_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_ALWAYS_EAGER=false

# Object Storage (s3 | r2 | minio | local_vault)
STORAGE_BACKEND=local_vault
LOCAL_VAULT_PATH=../ldi_private_vault
S3_BUCKET_NAME=ldi-documents-private
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_SSL=false

# AI Provider Configuration (GEMINI | OPENAI | LOCAL_DETERMINISTIC)
AI_PROVIDER=LOCAL_DETERMINISTIC
ALLOW_EXTERNAL_AI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OCR Configuration (TESSERACT | GOOGLE_DOC_AI | AZURE_DOC_INTELLIGENCE | LOCAL_FALLBACK)
OCR_PROVIDER=TESSERACT
GOOGLE_DOC_AI_ENDPOINT=
GOOGLE_DOC_AI_API_KEY=
AZURE_DOC_INTELLIGENCE_ENDPOINT=
AZURE_DOC_INTELLIGENCE_KEY=

# Upload & Security Limits
MAX_UPLOAD_FILE_SIZE_MB=25
MAX_BATCH_FILES=50
MAX_ZIP_EXTRACT_FILES=60
MAX_ZIP_EXTRACT_SIZE_MB=150
MAX_ZIP_COMPRESSION_RATIO=50
CLAMAV_HOST=
CLAMAV_PORT=3310

# Retention & Privacy (NDPA / GDPR alignment)
DEFAULT_RETENTION_DAYS=365
REDACT_PII_BEFORE_EXTERNAL_AI=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
